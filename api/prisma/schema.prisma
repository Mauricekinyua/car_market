generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

//"../src/generated/prisma"
datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String
  phone     String?
  listings  Listing[]
  createdAt DateTime  @default(now())
}

model Listing {
  id           String        @id @default(cuid())
  seller       User          @relation(fields: [sellerId], references: [id])
  title        String
  description  String
  price        Int
  make         Int
  model        String
  year         Int
  mileage      Int
  fuelType     String
  transmission String
  bodyType     String
  location     String
  status       ListingStatus @default(ACTIVE)
  images       Image[]
  sellerId     String
  createdAt    DateTime      @default(now())

  @@index([make, model])
  @@index([price])
  @@index([year])
}

model Image {
  id        String  @id @default(cuid())
  url       String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  position  Int     @default(0)
}

enum ListingStatus {
  ACTIVE
  SOLD
  HIDDEN
}
